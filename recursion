#include <iostream>

unsigned long long getFactorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * getFactorial(n - 1);
}

int main() {
    int n;
    std::cout << "Enter a positive integer: ";
    std::cin >> n;

    if (n < 0) {
        std::cout << "Error: Factorial of a negative number does not exist.";
    } else {
        std::cout << "Factorial of " << n << " = " << getFactorial(n);
    }

    return 0;
}
